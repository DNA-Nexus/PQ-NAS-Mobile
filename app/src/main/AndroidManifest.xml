<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Preserve original photo bytes when the user explicitly uploads media.
         Without this permission Android may redact EXIF GPS metadata. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PQNAS">

        <!-- nosemgrep: java.android.security.exported_activity.exported_activity - Launcher activity must be exported; privileged data access is still gated by app/session checks. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PQNAS">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- PQNAS_INCOMING_ANDROID_SHARE_V1: Receive Android Sharesheet files into DNA-Nexus. -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity - Exported by design for Android Sharesheet; IncomingShareStager accepts only SEND/SEND_MULTIPLE before private staging. -->
        <activity
            android:name=".IncomingShareActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.PQNAS">

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

        </activity>

        <!-- Camera/capture screen is intentionally portrait-first.
             The main app remains adaptive; this short-lived activity keeps the
             capture UI stable on phones. Android 16+ may still ignore fixed
             orientation on large screens. -->
        <activity
            android:name=".ui.screens.PortraitCaptureActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            tools:ignore="LockedOrientationActivity,DiscouragedApi" />

    </application>

</manifest>